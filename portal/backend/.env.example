RUNPOD_API_KEY=
# Set this to http://127.0.0.1:8500/v2 to use the local gateway.
RUNPOD_BASE=https://api.runpod.ai/v2
ALPHAFOLD_ENDPOINT_ID=
DIFFDOCK_ENDPOINT_ID=
PHASTEST_ENDPOINT_ID=
BIOEMU_ENDPOINT_ID=
ESMFOLD_ENDPOINT_ID=
RFDIFFUSION_ENDPOINT_ID=
PROTEINMPNN_ENDPOINT_ID=
MMSEQS_ENDPOINT_ID=
ROSETTA_RELAX_ENDPOINT_ID=
COLABFOLD_ENDPOINT_ID=
ALPHAFOLD3_ENDPOINT_ID=
SECRET_KEY=
# Shared secret the SSO forward_auth gateway sends as X-KBF-Auth. Must match
# KBF_FORWARD_AUTH_SECRET in the SSO gateway's env. When set, the backend only
# trusts the X-KBF-User identity header if X-KBF-Auth matches (anti-spoofing).
# In production set this (non-empty). If left empty, the X-KBF-User header is
# NOT trusted unless KBF_ALLOW_INSECURE_SSO_HEADER=true (fails closed).
KBF_FORWARD_AUTH_SECRET=
# Dev-only opt-in: trust X-KBF-User even when no secret is configured. Never set
# this in production.
KBF_ALLOW_INSECURE_SSO_HEADER=false
DATABASE_URL=sqlite:///./data/app.db
RETENTION_DAYS=7
POLL_INTERVAL_SECONDS=45
STORAGE_ROOT=/data
POLL_INTERVAL_SECONDS=45
