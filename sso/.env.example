# SSO forward_auth gateway (Keycloak OIDC) — copy to .env and fill in.
# Deployed instance reads /opt/bio_model_portal_sso/.env via the bmp-sso unit.

KBF_SESSION_SECRET=
KBF_OIDC_ISSUER=https://sso.k-biofoundrycopilot.duckdns.org/realms/kbf
KBF_OIDC_CLIENT_ID=bio-model-portal
KBF_OIDC_CLIENT_SECRET=
KBF_OIDC_SCOPES=openid profile email
KBF_UPSTREAM_BASE_URL=http://127.0.0.1:18120
KBF_SESSION_COOKIE_NAME=bmp_session
KBF_SESSION_COOKIE_SECURE=true
KBF_REQUIRE_ROLE=
# Must match KBF_FORWARD_AUTH_SECRET in the portal backend's .env. The gateway
# sends it as X-KBF-Auth so the backend can prove the identity headers came from
# here and not from a co-located process forging them.
KBF_FORWARD_AUTH_SECRET=
