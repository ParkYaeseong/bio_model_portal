# Optional bearer token. If set, all /v2/... calls require Authorization: Bearer <token>.
# Portal's RUNPOD_API_KEY must be set to the same value.
GATEWAY_TOKEN=

# Override the default endpoint config file path
# GATEWAY_ENDPOINTS=/home/pipeline/protein_pipeline/portal/gateway/endpoints.yaml

# How long completed/failed jobs stay in memory (seconds)
GATEWAY_JOB_TTL_SECONDS=86400
